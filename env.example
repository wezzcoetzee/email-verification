# Email Checker Configuration
# Copy this file to .env and adjust values as needed

# Input/Output directories
INPUT_FILE=data/data.json
INPUT_DIR=input
OUTPUT_DIR=output

# Convert mode settings
# Set CONVERT_ONLY=true to split a large input file into smaller files
CONVERT_ONLY=false
MAX_RECORDS_PER_FILE=100000

# Performance settings
WORKERS=16
BATCH_SIZE=1000
RATE_LIMIT=10ms

# Verification options
ENABLE_SMTP=true
VERBOSE=false

